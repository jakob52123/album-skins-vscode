    "foreground": "#89c8e4",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.bold"
   ],
   "settings": {
    "foreground": "#e5eff3",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.italic"
   ],
   "settings": {
    "foreground": "#e5eff3",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.underline.link",
    "string.other.link"
   ],
   "settings": {
    "foreground": "#d59432"
   }
  },
  {
   "scope": [
    "markup.quote"
   ],
   "settings": {
    "foreground": "#81a4b7",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.inserted"
   ],
   "settings": {
    "foreground": "#89c8e4"
   }
  },
  {
   "scope": [
    "markup.deleted"
   ],
   "settings": {
    "foreground": "#d1774b"
   }
  },
