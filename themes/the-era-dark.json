 "tokenColors": [
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#81a4b7",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage",
    "keyword.operator.new",
    "keyword.control"
   ],
   "settings": {
    "foreground": "#89c8e4"
   }
  },
  {
   "scope": [
    "keyword.operator",
    "punctuation",
    "meta.brace"
   ],
   "settings": {
    "foreground": "#a9c7d5"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "string.template",
    "markup.inline.raw"
   ],
   "settings": {
    "foreground": "#d1774b"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.character",
    "support.constant",
    "variable.other.constant",
    "variable.other.enummember"
   ],
   "settings": {
    "foreground": "#d3863f"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call",
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#d59432"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type",
    "support.class",
    "entity.other.inherited-class",
    "storage.type.primitive"
   ],
   "settings": {
    "foreground": "#a7b39d"
   }
  },
  {
   "scope": [
    "entity.name.tag",
    "meta.tag"
   ],
   "settings": {
    "foreground": "#89c8e4"
   }
  },
  {
   "scope": [
    "variable",
    "meta.definition.variable",
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#e5eff3"
   }
  },
  {
   "scope": [
    "variable.language",
    "variable.parameter.function.language.special"
   ],
   "settings": {
    "foreground": "#89c8e4",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
