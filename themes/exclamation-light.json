 "tokenColors": [
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#728994",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage",
    "keyword.operator.new",
    "keyword.control"
   ],
   "settings": {
    "foreground": "#6c427e"
   }
  },
  {
   "scope": [
    "keyword.operator",
    "punctuation",
    "meta.brace"
   ],
   "settings": {
    "foreground": "#586d7b"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "string.template",
    "markup.inline.raw"
   ],
   "settings": {
    "foreground": "#aa5b30"
   }
  },
  {
