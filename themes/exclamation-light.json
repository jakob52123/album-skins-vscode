    "constant.numeric",
    "constant.language",
    "constant.character",
    "support.constant",
    "variable.other.constant",
    "variable.other.enummember"
   ],
   "settings": {
    "foreground": "#98652a"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call",
    "entity.other.attribute-name"
