 "tokenColors": [
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#819e90",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage",
    "keyword.operator.new",
    "keyword.control"
   ],
   "settings": {
    "foreground": "#91c7ac"
   }
  },
  {
   "scope": [
    "keyword.operator",
    "punctuation",
    "meta.brace"
   ],
   "settings": {
    "foreground": "#abc3b6"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "string.template",
    "markup.inline.raw"
   ],
   "settings": {
    "foreground": "#d1774b"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.character",
    "support.constant",
    "variable.other.constant",
    "variable.other.enummember"
   ],
   "settings": {
    "foreground": "#d3863f"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
