 "tokenColors": [
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#a191b5",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage",
    "keyword.operator.new",
    "keyword.control"
   ],
   "settings": {
    "foreground": "#d6a9e4"
   }
  },
  {
   "scope": [
    "keyword.operator",
    "punctuation",
    "meta.brace"
   ],
   "settings": {
    "foreground": "#c4b5d6"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "string.template",
    "markup.inline.raw"
   ],
   "settings": {
    "foreground": "#d1774b"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.character",
    "support.constant",
    "variable.other.constant",
    "variable.other.enummember"
   ],
   "settings": {
    "foreground": "#d3863f"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call",
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#d59432"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type",
    "support.class",
    "entity.other.inherited-class",
    "storage.type.primitive"
   ],
   "settings": {
    "foreground": "#d6a19d"
   }
  },
  {
   "scope": [
    "entity.name.tag",
    "meta.tag"
   ],
   "settings": {
    "foreground": "#d6a9e4"
   }
  },
  {
   "scope": [
    "variable",
    "meta.definition.variable",
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#efeaf5"
   }
  },
  {
   "scope": [
    "variable.language",
    "variable.parameter.function.language.special"
   ],
   "settings": {
    "foreground": "#d6a9e4",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#d6a9e4",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.bold"
   ],
   "settings": {
    "foreground": "#efeaf5",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.italic"
   ],
   "settings": {
    "foreground": "#efeaf5",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.underline.link",
    "string.other.link"
   ],
   "settings": {
    "foreground": "#d59432"
   }
  },
  {
   "scope": [
    "markup.quote"
   ],
   "settings": {
    "foreground": "#a191b5",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.inserted"
   ],
   "settings": {
    "foreground": "#d6a9e4"
   }
  },
  {
   "scope": [
    "markup.deleted"
   ],
   "settings": {
    "foreground": "#d1774b"
   }
  },
  {
   "scope": [
    "invalid"
   ],
