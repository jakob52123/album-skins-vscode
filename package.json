    "colors": [
      {
        "id": "albumSkins.title",
        "description": "状态栏专辑名",
        "defaults": {
          "dark": "#d59432",
          "light": "#8a6a1c",
          "highContrast": "#ffd27a"
        }
      }
    ],
    "commands": [
      {
        "command": "albumSkins.pick",
        "title": "选专辑",
        "category": "专辑皮肤"
      },
      {
        "command": "albumSkins.next",
        "title": "换一张",
        "category": "专辑皮肤"
      },
      {
        "command": "albumSkins.daily",
        "title": "恢复每日随机",
        "category": "专辑皮肤"
      },
      {
        "command": "albumSkins.add",
        "title": "添加专辑…",
        "category": "专辑皮肤"
      },
      {
        "command": "albumSkins.toggleDiscreet",
        "title": "低调模式（开/关）",
        "category": "专辑皮肤"
      }
    ],
    "configuration": {
      "title": "专辑皮肤",
      "properties": {
        "albumSkins.dailyShuffle": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "description": "每天自动换一张专辑。"
        },
        "albumSkins.shuffle": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "favorites",
            "release-order"
          ],
          "order": 2,
          "enumDescriptions": [
            "从全部专辑（不含排除的）里洗牌，一轮内不重复",
            "只从收藏的专辑里洗牌",
            "按发行年份依次轮换"
          ],
          "description": "每日换专辑的方式。"
        },
        "albumSkins.favorites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "order": 3,
          "description": "收藏的专辑（在「选专辑」列表里点 ☆ 管理）。"
        },
        "albumSkins.excluded": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "order": 4,
          "description": "不参与每日随机的专辑（在「选专辑」列表里点 ⊘ 管理）。"
        },
        "albumSkins.followSystemAppearance": {
          "type": "boolean",
          "default": false,
          "order": 5,
          "description": "同一张专辑跟随系统外观：白天浅色、晚上深色（打开 VS Code 的 window.autoDetectColorScheme）。"
        },
        "albumSkins.discreet": {
          "type": "boolean",
          "default": false,
          "order": 6,
          "description": "低调模式：隐藏状态栏专辑名和封面，只保留配色。适合开会投屏。"
        },
        "albumSkins.syncBackground": {
          "type": "boolean",
          "default": false,
          "order": 7,
          "description": "用 background 扩展（shalldie.background）在窗口右侧显示渐隐的专辑封面。封面在首次开启时从 Apple iTunes 下载到本机；换专辑时即时跟着换；关掉会还原原来的背景。"
        },
        "albumSkins.backgroundOpacity": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0.05,
          "maximum": 0.6,
          "order": 8,
          "description": "渐隐封面的不透明度，越大越明显。null 按主题使用默认值（深色 0.30、浅色 0.22）。仅在 syncBackground 开启时生效。"
        },
        "albumSkins.backgroundOpacityDark": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0.05,
          "maximum": 0.6,
          "order": 9,
          "description": "深色主题的封面不透明度；null 继承 backgroundOpacity，未设置时为 0.30。"
        },
        "albumSkins.backgroundOpacityLight": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0.05,
          "maximum": 0.6,
          "order": 10,
          "description": "浅色主题的封面不透明度；null 继承 backgroundOpacity，未设置时为 0.22。"
        }
      }
    }
